# ============================================================
# Margins 知识库系统环境变量配置（后端本地开发）
# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量均有默认值；带"必填"标记的在对应功能使用前必须配置。
# ============================================================

# ------------------------------------------------------------
# 阿里云百炼（Embedding 向量化 + Rerank 重排序）
# ------------------------------------------------------------
# 必填（上传入库与问答都需要）。
# 百炼 API Key，获取：https://bailian.console.aliyun.com/ （API-KEY 管理）
DASHSCOPE_API_KEY=sk-xxx

# Embedding 模型名，默认 text-embedding-v4。
EMBEDDING_MODEL=text-embedding-v4

# Embedding 输出向量维度，默认 1024（支持 1024/768/512/256）。
# 注意：修改维度后需重新解析入库，否则向量维度不一致。
EMBEDDING_DIMENSION=1024

# Rerank 模型名，默认 qwen3-rerank；备选 gte-rerank-v2。
RERANK_MODEL=qwen3-rerank

# 重排序指令（可选，qwen3-rerank 支持 instruct 参数）；留空则不携带。
RERANK_INSTRUCT=

# ------------------------------------------------------------
# MinerU 在线文档解析
# ------------------------------------------------------------
# 必填（extract 通道；flash 快速通道免鉴权）。
# MinerU API Token，获取：https://mineru.net/apiManage/token
MINERU_API_TOKEN=xxx

# flash 快速通道文件大小上限（MB），默认 10；超过走 extract。
FLASH_MAX_SIZE_MB=10

# flash 快速通道页数上限，默认 20；PDF 超过此值走 extract。
FLASH_MAX_PAGES=20

# ------------------------------------------------------------
# LLM（OpenAI 兼容接口，默认 DeepSeek）
# ------------------------------------------------------------
# 必填（问答功能）。Base URL，默认 DeepSeek，可换任意 OpenAI 兼容服务。
LLM_BASE_URL=https://api.deepseek.com

# 必填（问答功能）。LLM API Key，DeepSeek：https://platform.deepseek.com
LLM_API_KEY=sk-xxx

# LLM 模型名，默认 deepseek-chat。
LLM_MODEL=deepseek-chat

# ------------------------------------------------------------
# 存储路径
# ------------------------------------------------------------
# 数据根目录（SQLite、Faiss、上传、解析结果），默认 ./data。
DATA_DIR=./data

# ------------------------------------------------------------
# 检索参数
# ------------------------------------------------------------
RECALL_K=30           # 每路召回条数（Faiss 稠密 / BM25 稀疏）
RERANK_TOP_N=6        # 重排后保留条数（最终进上下文的条数上限）
RELEVANCE_THRESHOLD=0.3  # 相关性阈值，0 关闭；噪声多可调高
MAX_CITATIONS=5       # 引用展示上限（仅统计回答实际引用的 [n]）
MAX_CHUNKS_PER_DOCUMENT=3  # 同一文档最多进上下文的 chunk 数
MIN_CHUNK_CHARS=30    # 过短 chunk 过滤（字符数）
HISTORY_LIMIT=6       # 问答带入的最近历史消息条数

# ------------------------------------------------------------
# 查询改写（改写路由）
# ------------------------------------------------------------
REWRITE_ENABLED=true  # 查询改写总开关；false 时始终用原始问题
REWRITE_TEMPERATURE=0.2  # 改写决策 LLM 温度

# ------------------------------------------------------------
# 解析任务队列
# ------------------------------------------------------------
QUEUE__CONCURRENCY=2  # 同时解析的最大文档数
QUEUE__MAX_RETRIES=3  # 解析失败最大重试次数

# ------------------------------------------------------------
# 日志
# ------------------------------------------------------------
LOG_LEVEL=INFO        # DEBUG / INFO / WARNING / ERROR
