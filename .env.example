# ===== 阿里云百炼（Embedding / Rerank）=====
DASHSCOPE_API_KEY=sk-xxx
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
RERANK_MODEL=qwen3-rerank

# ===== MinerU 在线解析 =====
MINERU_API_TOKEN=xxx
FLASH_MAX_SIZE_MB=10
FLASH_MAX_PAGES=20

# ===== LLM（OpenAI 兼容，默认 DeepSeek）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# ===== 存储路径 =====
DATA_DIR=./data

# ===== 检索参数 =====
DENSE_K=30
SPARSE_K=30
RRF_K=60
FUSION_TOP_N=30
RERANK_TOP_N=6
FINAL_K=10
RELEVANCE_THRESHOLD=0.3
MAX_CITATIONS=5
MAX_CHUNKS_PER_DOCUMENT=3
MIN_CHUNK_CHARS=30
HISTORY_LIMIT=6
CONTEXT_TOKEN_BUDGET=12000

# ===== 查询重写 =====
REWRITE_ENABLED=true
REWRITE_TEMPERATURE=0.2
RERANK_INSTRUCT=

# ===== 任务队列 =====
QUEUE__CONCURRENCY=2
QUEUE__MAX_RETRIES=3

# ===== 日志 =====
LOG_LEVEL=INFO
