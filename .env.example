# ============================================================
# Margins 知识库系统环境变量配置
# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量均有默认值；带"必填"标记的在对应功能使用前必须配置。
# ============================================================

# ------------------------------------------------------------
# 阿里云百炼（Embedding 向量化 + Rerank 重排序）
# ------------------------------------------------------------
# 必填（上传入库与问答都需要）。
# 百炼 API Key，获取：https://bailian.console.aliyun.com/ （API-KEY 管理）
DASHSCOPE_API_KEY=sk-xxx

# Embedding 模型名，默认 text-embedding-v4（百炼官方文档模型）。
EMBEDDING_MODEL=text-embedding-v4

# Embedding 输出向量维度，默认 1024。
# text-embedding-v4 支持 1024 / 768 / 512 / 256。
# 注意：修改维度后向量库中旧向量维度不一致，需要重新解析入库。
EMBEDDING_DIMENSION=1024

# Rerank 模型名，默认 qwen3-rerank；备选 gte-rerank-v2。
RERANK_MODEL=qwen3-rerank

# 重排序指令（可选，qwen3-rerank 支持 instruct 参数）。
# 留空则调用时不携带 instruct；例如可填：
# "Given a web search query, retrieve relevant passages that answer the query."
RERANK_INSTRUCT=

# ------------------------------------------------------------
# MinerU 在线文档解析
# ------------------------------------------------------------
# 必填（extract 通道；flash 快速通道免鉴权）。
# MinerU API Token，获取：https://mineru.net/apiManage/token
MINERU_API_TOKEN=xxx

# flash 快速通道的文件大小上限（MB），默认 10。
# 大于此值走 extract 通道（消耗 Token）。
FLASH_MAX_SIZE_MB=10

# flash 快速通道的页数上限，默认 20。
# PDF 页数超过此值走 extract 通道（即使文件很小）。
FLASH_MAX_PAGES=20

# ------------------------------------------------------------
# LLM（OpenAI 兼容接口，默认 DeepSeek）
# ------------------------------------------------------------
# 必填（问答功能）。LLM API Base URL，默认 DeepSeek：
# https://api.deepseek.com
# 可替换为任意 OpenAI 兼容服务（如 OpenAI、通义等）。
LLM_BASE_URL=https://api.deepseek.com

# 必填（问答功能）。LLM API Key，
# DeepSeek 获取：https://platform.deepseek.com
LLM_API_KEY=sk-xxx

# LLM 模型名，默认 deepseek-chat。
LLM_MODEL=deepseek-chat

# ------------------------------------------------------------
# 存储路径
# ------------------------------------------------------------
# 数据根目录（SQLite、Faiss 索引、上传文件、解析结果），默认 ./data。
# Docker Compose 部署时为 /app/data（由 compose 覆盖并挂载数据卷）。
DATA_DIR=./data

# ------------------------------------------------------------
# 检索参数
# ------------------------------------------------------------
# 稠密检索（Faiss）每路召回条数，默认 30。
DENSE_K=30

# 稀疏检索（BM25）每路召回条数，默认 30。
SPARSE_K=30

# RRF 融合常数 k，默认 60（业界常用值，越大越偏向排序靠前的路）。
RRF_K=60

# RRF 融合后保留的候选条数，默认 30（进入重排的输入规模）。
FUSION_TOP_N=30

# 重排后保留条数，默认 6（最终进上下文的条数上限之一）。
# 越小上下文越聚焦，过大容易混入噪声。
RERANK_TOP_N=6

# 最终进入 LLM 上下文的条数上限，默认 10。
# 实际生效为 min(RERANK_TOP_N, FINAL_K)。
FINAL_K=10

# 相关性阈值（重排分数 / 稠密相似度），低于此值剔除；设为 0 关闭过滤。
# 默认 0.3；噪声多时可调高到 0.4-0.5。
RELEVANCE_THRESHOLD=0.3

# 回答中引用展示的上限条数（仅统计回答实际引用的 [n]），默认 5。
MAX_CITATIONS=5

# 同一文档最多进入上下文的 chunk 数，默认 3。
# 防止单一文档刷屏、保证回答覆盖多份资料。
MAX_CHUNKS_PER_DOCUMENT=3

# 正文过短过滤（字符数），默认 30。
# 低于此长度的 chunk（如纯标题页）不进上下文。
MIN_CHUNK_CHARS=30

# 问答时带入的最近历史消息条数，默认 6。
# 跨主题连续提问时可调小（如 3）减少干扰。
HISTORY_LIMIT=6

# 上下文 Token 预算（约），默认 12000。
# 控制引用片段总量，防止超出模型窗口；按模型上下文大小调整。
CONTEXT_TOKEN_BUDGET=12000

# ------------------------------------------------------------
# 查询改写（改写路由）
# ------------------------------------------------------------
# 查询改写总开关，默认 true。
# true：先由 LLM 判断是否需要改写（明确的问题不改写，只跑一次检索）；
# false：完全跳过决策调用，始终用原始问题。
REWRITE_ENABLED=true

# 改写决策时 LLM 的温度，默认 0.2（低温度保证决策稳定）。
REWRITE_TEMPERATURE=0.2

# ------------------------------------------------------------
# 解析任务队列
# ------------------------------------------------------------
# 同时解析的最大文档数，默认 2（并发过高易触发 MinerU 限流）。
QUEUE__CONCURRENCY=2

# 解析失败的最大重试次数，默认 3（指数退避：1s/5s/15s）。
QUEUE__MAX_RETRIES=3

# ------------------------------------------------------------
# 日志
# ------------------------------------------------------------
# 日志级别：DEBUG / INFO / WARNING / ERROR。
# DEBUG 会输出更多明细（如向量细节）；日常建议 INFO。
LOG_LEVEL=INFO
